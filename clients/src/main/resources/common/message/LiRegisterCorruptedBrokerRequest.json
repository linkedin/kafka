{
  "apiKey": 1003,
  "type": "request",
  "listeners": ["controller"],
  "name": "LiRegisterCorruptedBrokerRequest",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "BrokerId", "type": "int32", "versions": "0+", "entityType": "brokerId",
      "about": "The broker ID of the corrupted broker." },
    { "name": "BrokerEpoch", "type": "int64", "versions": "0+",
      "about": "The broker epoch of the corrupted broker." },
    { "name": "Topics", "type": "[]CorruptedBrokerTopic", "versions": "0+",
      "about": "Each topic on the broker.", "fields": [
      { "name": "Name", "type": "string", "versions": "0+", "entityType": "topicName",
        "about": "The topic name" },
      { "name": "Partitions", "type": "[]CorruptedBrokerPartition", "versions": "0+",
        "about": "Each partition on the broker.", "fields": [
        { "name": "PartitionIndex", "type": "int32", "versions": "0+",
          "about": "The partition index." },
        { "name": "LatestOffset", "type": "int64", "versions": "0+",
          "about": "The latest offset for the partition." },
        { "name": "LatestLeaderEpoch", "type": "int32", "versions": "0+",
          "about": "The leader epoch for the latest offset of the partition." }
      ]}
    ]}
  ]
}
